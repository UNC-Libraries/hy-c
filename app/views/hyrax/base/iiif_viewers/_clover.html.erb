<%# [hyc-override] Clover IIIF viewer  File doesn't exist in the main hyrax branch %>
<%# If it did, it would be here:  https://github.com/samvera/hyrax/blob/main/app/views/hyrax/base/iiif_viewers/_clover.html.erb %>
<div class="viewer-wrapper clover-viewer-wrapper">
  <iframe title="image view" id="unc-clover-viewer"
          src="<%= iiif_viewer_base_url(presenter.iiif_viewer) %>?manifest=<%= main_app.polymorphic_url [main_app, :manifest, presenter], { locale: nil } %>"
          allowfullscreen="allowfullscreen" style="width: 100%; height: 320px; border: none; display: block;"></iframe>
</div>

<script>
    (function() {
        const wrapper = document.querySelector(".clover-viewer-wrapper");
        const iframe = document.getElementById("unc-clover-viewer");
        if (!wrapper || !iframe) return;

        window.addEventListener("message", function(event) {
            if (event.origin !== window.location.origin) return;
            if (!event.data || event.data.type !== "clover:height") return;
            if (!event.data.height) return;

            wrapper.style.height = event.data.height + "px";
            iframe.style.height = event.data.height + "px";
        });
    })();
</script>
