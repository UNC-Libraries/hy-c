<%# [hyc-override] https://github.com/projectblacklight/blacklight/blob/v7.43.0/app/components/blacklight/advanced_search_form_component.html.erb %>
<% if constraints? %>
  <div class="constraints well search_history">
    <h4><%= t 'blacklight.advanced_search.form.search_context' %></h4>
    <% constraints.each do |constraint| %>
      <%= constraint %>
    <% end %>
  </div>
<% end %>

<%= form_tag @url, method: @method, class: @classes.join(' '), role: 'search', 'aria-label' => t('blacklight.search.form.submit') do %>
  <%# Preserve existing search parameters without changing the original search state. %>
  <% hidden_params = @params.deep_dup.with_indifferent_access %>
  <% if hidden_params[:f_inclusive] %>
    <%# Multi-select controls submit their own f_inclusive values. Omitting their hidden
        fields prevents removed selections from being submitted again; other filters remain. %>
    <% blacklight_config.facet_fields.each_value do |field| %>
      <% hidden_params[:f_inclusive].delete(field.key) if field.advanced_search_component == AdvancedSearch::MultiSelectFacetComponent %>
    <% end %>
  <% end %>
  <%= render_hash_as_hidden_fields(hidden_params) %>

  <div class="input-criteria">
    <div class="query-criteria mb-4">
      <h2 class="query-criteria-heading h3 mb-4">
        <%= t('blacklight.advanced_search.form.query_criteria_heading_html', select_menu: default_operator_menu) %>
      </h2>

      <div id="advanced_search">
        <% search_field_controls.each do |control| %>
          <%= control %>
        <% end %>
      </div>
    </div>

    <% if search_filter_controls? %>
      <div class="limit-criteria mb-4">
        <h2 class="limit-criteria-heading h3"><%= t('blacklight.advanced_search.form.limit_criteria_heading_html') %></h2>
        <%# Show the server's maximum and provide an error for client-side validation. %>
        <p><%= t('blacklight.advanced_search.facet_field_limit', count: CatalogController::MAX_SEARCH_FACET_FIELDS) %></p>
        <div class="alert alert-danger advanced-search-facet-error" role="alert" hidden><%= t('blacklight.advanced_search.facet_field_limit', count: CatalogController::MAX_SEARCH_FACET_FIELDS) %></div>

        <%# JavaScript reads this limit to check the number of selected facet fields before submission. %>
        <div id="advanced_search_facets" class="limit_input row" data-max-facet-fields="<%= CatalogController::MAX_SEARCH_FACET_FIELDS %>">
          <div class="advanced-facet-limits panel-group col-md-9 offset-md-3">
            <% search_filter_controls.each do |control| %>
              <%= control %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if sort_fields_select %>
    <div class="form-group row mb-4">
      <%= content_tag :h2, t('blacklight.advanced_search.form.sort_label'), id: 'advanced-search-sort-label', class: 'col-md-3 text-md-right' %>
      <div class="col-md-9">
        <%= sort_fields_select %>
      </div>
    </div>
  <% end %>

  <div class="form-group row">
    <div class="submit-buttons col-md-9 offset-md-3">
      <%= submit_tag t('blacklight.advanced_search.form.search_btn_html'), class: 'btn btn-primary advanced-search-submit', id: 'advanced-search-submit' %>
      <%# [hyc-override] Replace the reset button with a link to a blank form %>
      <%= link_to t('blacklight.advanced_search.form.start_over_html'), helpers.search_action_path(action: 'advanced_search'), class: 'btn btn-link advanced-search-start-over' %>
    </div>
  </div>
<% end %>
